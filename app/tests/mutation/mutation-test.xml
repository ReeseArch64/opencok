<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.2">
  <directories>
    <directory recursive="true">lib
      <matching pattern="^(?!.*_test\.dart$).*\.dart$"/>
    </directory>
  </directories>
  <commands>
    <command expected-return="0" timeout="120">flutter test lib --no-pub</command>
  </commands>
</mutations>
