{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2",
      "zod": "^4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint --config .oxlintrc.json . --deny-warnings",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix --deny-warnings",
    "format": "vp fmt --config .oxfmtrc.json . --write",
    "format:check": "vp fmt --config .oxfmtrc.json . --check",
    "check-types": "vp check-types",
    "test:stack": "bun --no-env-file test tests/stack"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "^1.3.0"
  },
  "packageManager": "bun@1.4.2"
}
