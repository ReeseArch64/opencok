{
  "name": "opencok",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "app",
      "gameserver"
    ],
    "catalog": {
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2",
      "zod": "^4.6.7",
      "effect": "4.0.6",
      "@effect/platform-bun": "4.0.6"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "check-types": "turbo check-types",
    "prepare": "husky",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:contract": "turbo test:contract",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:snapshot": "turbo test:snapshot",
    "test:property": "turbo test:property",
    "test:coverage": "turbo test:coverage",
    "test:mutation": "timeout --signal=INT --kill-after=5s 285s bunx turbo test:mutation --ui=stream"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dprint/typescript": "^0.99.2",
    "@opencok/config": "workspace:",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "catalog:",
    "dprint": "^0.64.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  }
}
