{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2",
      "zod": "^4.6.7",
      "effect": "4.0.6",
      "@effect/platform-bun": "4.0.6"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint --config .oxlintrc.json . --deny-warnings",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix --deny-warnings",
    "format": "dprint fmt --config dprint.json && vp fmt --config .oxfmtrc.json . --write",
    "format:check": "dprint check --config dprint.json && vp fmt --config .oxfmtrc.json . --check",
    "check-types": "vp check-types",
    "test:packages": "bun --no-env-file test packages/resources/tests packages/validations/tests packages/mappings/tests packages/controllers/tests packages/rules/tests packages/policy/tests packages/shop/tests packages/player/tests packages/catalog-tools/tests packages/account/tests packages/economy/tests packages/ledger/tests packages/messages/tests packages/production/tests packages/building/tests packages/city/tests packages/research/tests packages/troops/tests packages/equipment/tests packages/tasks/tests packages/skins/tests",
    "prepare": "husky",
    "commitlint": "commitlint",
    "test:architecture": "bun --no-env-file test tests/architecture",
    "check-types:architecture": "tsc --noEmit -p tests/architecture/tsconfig.json",
    "inventory:architecture": "bun --no-env-file tests/architecture/inventory.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@opencok/config": "workspace:*",
    "@opencok/messages": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "9.1.7",
    "typescript": "catalog:",
    "vite-plus": "^1.3.0",
    "@opencok/resources": "workspace:*",
    "dprint": "0.64.3",
    "@dprint/typescript": "0.96.1",
    "esbuild": "0.28.2",
    "rolldown": "1.2.15",
    "rollup": "4.65.1",
    "@swc/core": "1.16.20",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0"
  },
  "packageManager": "bun@1.4.2"
}
