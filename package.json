{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.3",
      "typescript": "^7.0.2",
      "zod": "^4.6.7",
      "effect": "4.0.6",
      "@effect/platform-bun": "4.0.6"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint --config .oxlintrc.json . --deny-warnings",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix --deny-warnings",
    "format": "vp fmt --config .oxfmtrc.json . --write",
    "format:check": "vp fmt --config .oxfmtrc.json . --check",
    "check-types": "vp check-types",
    "test:packages": "bun --no-env-file test packages/resources/tests packages/validations/tests packages/mappings/tests packages/controllers/tests packages/rules/tests",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@opencok/config": "workspace:*",
    "@opencok/messages": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "9.1.7",
    "typescript": "catalog:",
    "vite-plus": "^1.3.0",
    "@opencok/resources": "workspace:*"
  },
  "packageManager": "bun@1.4.2"
}
