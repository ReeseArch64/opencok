{
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "data/**",
    ".husky/_/**",
    "packages/drizzle/migrations/**",
    "**/__snapshots__/**",
    "packages/drizzle/tests/fixtures/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"]
  }
}
