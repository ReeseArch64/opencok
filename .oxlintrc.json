{
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "data/**",
    ".husky/_/**",
    "packages/drizzle/migrations/**",
    "**/__snapshots__/**",
    "packages/drizzle/tests/fixtures/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "curly": ["error", "all"]
      }
    }
  ]
}
