{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "**/__snapshots__/**",
    "data/**",
    "docker/**",
    "gameserver",
    "app",
    ".husky/_/**",
    ".github/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "curly": ["error", "all"]
      }
    }
  ]
}
