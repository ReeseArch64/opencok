{
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "mobile/**",
    "legacy/**",
    "data/**",
    "packages/drizzle/migrations/**",
    "**/__snapshots__/**",
    "packages/drizzle/tests/fixtures/**"
