NODE_ENV=development

DATABASE_ROLE=global

DATABASE_URL=postgres://postgres:postgres@postgres:5432/opencok_global

GAME_LOGIN_SECRET=your_game_login_secret_here
GAME_MAIL_TRANSLATION=true
GAME_CROSS_SEARCH=true
GAME_CHAT_INTERVAL=1
GAME_FEED_MAX_COUNT=3
GAME_PLAYER_KINGDOMS=
GAME_MAIL_CHAT_URL=
GAME_CHAT_SESSION_URL=
GAME_AVATAR_CHAT_URL=
GAME_FILES_URL=
API_CHAT_URL=

CHAT_HOST=127.0.0.1
CHAT_PORT=8083
CHAT_WEBSOCKET_URL=ws://127.0.0.1:8083/chat/ws
CHAT_SIGNING_SECRET=
CHAT_KINGDOM_DATABASES=1:opencok_kingdom_1,2:opencok_kingdom_2

API_FILES_ENABLED=false
FILES_SIGNING_KEY_FILE=/run/opencok/image-upload-key
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=opencok-uploads
S3_FORCE_PATH_STYLE=true
