# Copy to .env at the workspace root and fill connection URLs privately.
# The same file is used by server packages and database tools.
# General settings: @opencok/env
NODE_ENV=development

# Database settings: @opencok/env/database
DATABASE_ROLE=global

# Runtime/database-tool connection. Select the PostgreSQL cluster or target DB.
DATABASE_URL=

# Administrative connection used only by db:setup to create missing databases.
POSTGRES_ADMIN_URL=
