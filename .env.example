NODE_ENV=development

DATABASE_ROLE=global

DATABASE_URL=postgres://postgres:postgres@database:5432/opencok_global

GAME_LOGIN_SECRET=your_game_login_secret_here
GAME_MAIL_TRANSLATION=true

CHAT_HOST=127.0.0.1
CHAT_PORT=8083
CHAT_WEBSOCKET_URL=ws://127.0.0.1:8083/chat/ws
CHAT_SIGNING_SECRET=
CHAT_KINGDOM_DATABASES=1:opencok_kingdom_1,2:opencok_kingdom_2

FILES_HOST=127.0.0.1
FILES_PORT=8084
FILES_SIGNING_KEY_FILE=/run/opencok/image-upload-key
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=opencok-uploads
S3_FORCE_PATH_STYLE=true
