http:
  routers:
    health:
      entryPoints: [web]
      rule: (Path(`/healthz`) || Path(`/readyz`) || Path(`/_health.php`)) && (Method(`GET`) || Method(`HEAD`))
      service: api
    discovery:
      entryPoints: [web]
      rule: (Path(`/gameservice/getserverlist.php`) || Path(`/gameservice/getline.php`) || Path(`/gameservice/getserverlist_memoryold.php`)) && (Method(`GET`) || Method(`HEAD`) || Method(`POST`))
      middlewares: [discovery-body]
      service: api
    chat-discovery:
      entryPoints: [web]
      rule: (Path(`/api/v1global_config`) || Path(`/chat/server/links`) || Path(`/chat/server/all`)) && Method(`GET`)
      service: api
    avatar-upload:
      entryPoints: [web]
      rule: Path(`/gameservice/www/gateway/json.php`) && Method(`POST`)
      middlewares: [upload-body]
      service: api
    {{ if env "S3_ENDPOINT" }}
    avatar-storage:
      entryPoints: [web]
      rule: PathRegexp(`^/opencok-uploads/[0-9]{1,6}/[a-f0-9]{32}\.jpg$`) && (Method(`GET`) || Method(`HEAD`))
      service: avatar-storage
    {{ end }}
    avatar-images:
      entryPoints: [web]
      rule: PathRegexp(`^/cok/img/[0-9]{1,6}/[a-f0-9]{32}\.jpg$`) && (Method(`GET`) || Method(`HEAD`))
      service: api
    cdn-cok:
      entryPoints: [web]
      rule: PathPrefix(`/cok/`) && !PathPrefix(`/cok/img/`) && !PathRegexp(`(^|/)\.`) && !PathRegexp(`(?i)\.part(/|$)`) && !PathRegexp(`(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|bash|asp|aspx|jsp)([./]|$)`) && (Method(`GET`) || Method(`HEAD`))
      middlewares: [cdn-cok-path]
      service: cdn-storage
    cdn-assets:
      entryPoints: [web]
      rule: PathPrefix(`/100001/`) && !PathRegexp(`(^|/)\.`) && !PathRegexp(`(?i)\.part(/|$)`) && !PathRegexp(`(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|bash|asp|aspx|jsp)([./]|$)`) && (Method(`GET`) || Method(`HEAD`))
      middlewares: [cdn-assets-path]
      service: cdn-storage
  middlewares:
    upload-body:
      buffering:
        maxRequestBodyBytes: 2162688
    cdn-cok-path:
      addPrefix:
        prefix: /opencok-cdn/cok.eleximg.com
    cdn-assets-path:
      addPrefix:
        prefix: /opencok-cdn/asset.cok.chat
    discovery-body:
      buffering:
        maxRequestBodyBytes: 65536
  services:
    {{ if env "S3_ENDPOINT" }}
    avatar-storage:
      loadBalancer:
        passHostHeader: true
        serversTransport: api-transport
        servers:
          - url: '{{ env "S3_ENDPOINT" }}'
    {{ end }}
    cdn-storage:
      loadBalancer:
        passHostHeader: false
        serversTransport: cdn-transport
        servers:
          - url: '{{ env "CDN_URL" }}'
    api:
      loadBalancer:
        serversTransport: api-transport
        servers:
          - url: http://api:8080
  serversTransports:
    cdn-transport:
      forwardingTimeouts:
        dialTimeout: 3s
        responseHeaderTimeout: 65s
    api-transport:
      forwardingTimeouts:
        dialTimeout: 3s
        responseHeaderTimeout: 10s

tcp:
  routers:
    game:
      entryPoints: [game]
      rule: HostSNI(`*`)
      service: game
  services:
    game:
      loadBalancer:
        serversTransport: game-transport
        servers:
          - address: server:9933
  serversTransports:
    game-transport:
      dialTimeout: 3s
