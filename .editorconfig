# Keep formatting consistent across editors that support EditorConfig.
# Stop looking for additional .editorconfig files in parent directories.
root = true

# Apply these defaults to every file unless a section below overrides them.
[*]
# Use spaces instead of tab characters for indentation.
indent_style = space
# Use two spaces per indentation level by default.
indent_size = 2
# Use Unix-style line endings on every operating system.
end_of_line = lf
# Save text files using UTF-8 encoding.
charset = utf-8
# Preserve trailing whitespace by default, including meaningful Markdown spaces.
trim_trailing_whitespace = false
# Ensure every non-empty file ends with a newline.
insert_final_newline = true

# Override the defaults for PHP files at any directory depth.
# All settings not listed here are inherited from the global section.
[*.php]
# Use four spaces per indentation level for PHP source code.
indent_size = 4
# Remove unnecessary whitespace at the end of PHP lines when saving.
trim_trailing_whitespace = true

# Override the defaults for Python files at any directory depth.
# All settings not listed here are inherited from the global section.
[*.py]
# Use four spaces per indentation level for Python source code.
indent_size = 4
# Remove unnecessary whitespace at the end of Python lines when saving.
trim_trailing_whitespace = true
