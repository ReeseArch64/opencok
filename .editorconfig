root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{go,mod,work}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{py,pyi,ts}]
indent_size = 4

[*.dart]
indent_size = 2
max_line_length = 80

[*.{js,tsx,mjs,cjs,svelte}]
indent_size = 2

[*.{yaml,yml,json,jsonc,toml,arb}]
indent_size = 2

[*.{kt,kts,java,swift}]
indent_size = 4

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false
