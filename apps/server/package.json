{
  "name": "@opencok/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --no-env-file src/index.ts",
    "dev": "bun --no-env-file --watch src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun --no-env-file test ./test",
    "test:integration": "bun --no-env-file test integration",
    "test:mutations": "bun --no-env-file scripts/mutate-auth.ts",
    "avatar:moderate": "bun --no-env-file scripts/moderate-avatar.ts",
    "test:timed-mutations": "bun --no-env-file scripts/mutate-timed-economy.ts",
    "test:city-mutations": "bun --no-env-file scripts/mutate-city-progression.ts",
    "test:progression-mutations": "bun --no-env-file scripts/mutate-progression-domains.ts",
    "test:player-progression-mutations": "bun --no-env-file scripts/mutate-player-progression.ts",
    "world:import": "bun --no-env-file scripts/import-world-terrain.ts",
    "build": "bun build src/index.ts --target bun --minify --outdir dist/src && mkdir -p dist/data && cp ../../packages/resources/data/badwords.json dist/data/badwords.json"
  },
  "dependencies": {
    "@opencok/connection": "workspace:*",
    "@opencok/contracts": "workspace:*",
    "@opencok/controllers": "workspace:*",
    "@opencok/env": "workspace:*",
    "@opencok/repositories": "workspace:*",
    "@opencok/resources": "workspace:*",
    "@opencok/storage": "workspace:*",
    "effect": "catalog:",
    "@opencok/core": "workspace:*",
    "@opencok/rules": "workspace:*",
    "@opencok/mappings": "workspace:*",
    "@opencok/services": "workspace:*",
    "@opencok/hero": "workspace:*"
  },
  "devDependencies": {
    "@opencok/api": "workspace:*",
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@opencok/drizzle": "workspace:*",
    "@opencok/identity": "workspace:*",
    "@opencok/messages": "workspace:*",
    "drizzle-orm": "0.45.4",
    "@opencok/ledger": "workspace:*"
  }
}
