{
  "name": "@opencok/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --no-env-file src/index.ts",
    "dev": "bun --no-env-file --watch src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun --no-env-file test ./test",
    "test:integration": "bun --no-env-file test integration",
    "test:mutations": "bun --no-env-file scripts/mutate-auth.ts"
  },
  "dependencies": {
    "@opencok/connection": "workspace:*",
    "@opencok/contracts": "workspace:*",
    "@opencok/controllers": "workspace:*",
    "@opencok/env": "workspace:*",
    "@opencok/repositories": "workspace:*",
    "@opencok/resources": "workspace:*",
    "@opencok/storage": "workspace:*",
    "effect": "catalog:",
    "@opencok/core": "workspace:*",
    "@opencok/rules": "workspace:*"
  },
  "devDependencies": {
    "@opencok/api": "workspace:*",
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@opencok/drizzle": "workspace:*",
    "@opencok/dtos": "workspace:*",
    "@opencok/identity": "workspace:*",
    "@opencok/messages": "workspace:*",
    "drizzle-orm": "0.45.4"
  }
}
