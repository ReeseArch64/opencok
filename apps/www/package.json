{
  "name": "@opencok/www",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:prepare": "bun scripts/prepare-assets.mjs",
    "dev": "bun run assets:prepare && astro dev --host 0.0.0.0",
    "build": "bun run assets:prepare && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "bun test test && python3 -B -m unittest discover -s test -p '*_test.py'"
  },
  "dependencies": {
    "astro": "^6.0.0"
  }
}
