---
import Layout from "../layouts/layout.astro";
import Card from "../components/card.astro";
import { catalog, categories, statusLabel } from "../lib/catalog.mjs";
import { site } from "../data/site.mjs";
const troops = ["57580118", "57580318", "57580518", "57580718"].map((id) =>
  catalog.find((item) => item.reference === id),
);
const skins = catalog.filter((item) => item.category === "skins");
const events = catalog.filter((item) => item.category === "eventos");
---

<Layout>
  <section class="hero">
    <img
      class="hero-image"
      src="/media/world.jpg"
      alt="Castelo dourado cercado por montanhas, rios e exércitos"
      fetchpriority="high"
      width="1200"
      height="628"
    />

    <div class="hero-content wrap">
      <p class="eyebrow ornament">ESTRATÉGIA. ALIANÇA. CONQUISTA.</p>
      <h1>
        Seu reino.
        <br />
        Sua <em>história.</em>
      </h1>
      <p class="hero-description">
        Erga sua cidade, reúna seu exército e encontre aliados.
        <br class="desktop" /> Um mundo de lendas espera pelo seu próximo
        movimento.
      </p>
      <div class="actions">
        <a class="button" href="/jogar/">
          Comece sua jornada <span>↗</span>
        </a>
        <a class="button ghost" href="/wiki/">
          Explore o universo <span>↓</span>
        </a>
      </div>
      <div class="hero-caption">
        <span class="line"></span> UM NOVO CAPÍTULO DE CLASH OF KINGS
      </div>
    </div>
    <a href="#universo" class="scroll-cue" aria-label="Explorar o universo">
      EXPLORE <span>↓</span>
    </a>
  </section>

  <div class="platform-strip">
    <span>SEU REINO, ONDE VOCÊ ESTIVER</span>
    <a href="/jogar/#android">
      ◇ Android{" "}
      <small>{statusLabel(site.androidUrl ? "available" : "soon")}</small>
    </a>
    <a href="/jogar/#ios">
      ◈ iOS <small>{statusLabel(site.iosUrl ? "available" : "soon")}</small>
    </a>
    <a href="/jogar/#web">
      ◎ Navegador <small>Conheça o acesso web ↗</small>
    </a>
  </div>

  <section id="universo" class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">O CONHECIMENTO É SUA PRIMEIRA CONQUISTA</p>
        <h2>
          Explore o universo <em>OpenCoK.</em>
        </h2>
      </div>
      <p>
        Do primeiro soldado à sua próxima fortaleza.
        <br />
        Tudo o que você precisa conhecer, em um só lugar.
      </p>
    </div>

    <div class="category-grid">
      {Object.entries(categories).map(([key, category], i) => (
        <a href={`/catalogo/${key}/`} class="category-tile">
          <span class="category-symbol">{category.symbol}</span>
          <span class="number">0{i + 1}</span>
          <h3>{category.name}</h3>
          <p>
            {catalog.filter((item) => item.category === key).length} itens no
            catálogo
          </p>
          <span class="tile-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section troops-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A FORÇA POR TRÁS DA SUA BANDEIRA</p>
          <h2>
            Nascidos para a <em>batalha.</em>
          </h2>
        </div>
        <a class="text-link" href="/catalogo/tropas/">
          Conhecer todas as tropas <span>↗</span>
        </a>
      </div>
      <div class="card-grid">
        {troops.map((item) => (
          <Card item={item} />
        ))}
      </div>
      <div class="section-note">
        <span>⚔</span>
        <p>
          Infantaria, cavalaria, arqueiros e cerco. Explore as unidades por
          família e tier para conhecer seu futuro exército.
        </p>
        <a href="/wiki/tropas-e-formacoes/">Guia de tropas →</a>
      </div>
    </div>
  </section>

  <section class="section wrap skins-feature">
    <div class="skins-intro">
      <p class="eyebrow">MUITO ALÉM DAS MURALHAS</p>
      <h2>
        Um castelo.
        <br />
        Infinitas <em>identidades.</em>
      </h2>
      <p>
        Faça do seu reino uma extensão da sua história. Descubra fortalezas,
        mundos gelados e castelos que desafiam os céus.
      </p>
      <a class="button ghost" href="/catalogo/skins/">
        Explorar skins <span>↗</span>
      </a>
      <div class="mini-avatars">
        {catalog
          .filter((i) => i.category === "avatares")
          .slice(0, 5)
          .map((item) => (
            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              width="48"
              height="48"
            />
          ))}
        <a href="/catalogo/avatares/">Encontre seu avatar ↗</a>
      </div>
    </div>
    <a href={`/wiki/${skins[1].id}/`} class="featured-skin">
      <span class="eyebrow">COLEÇÃO DE CASTELOS</span>
      <img
        src={skins[1].image}
        alt={skins[1].name}
        width="440"
        height="380"
        loading="lazy"
      />
      <div>
        <h3>{skins[1].name}</h3>
        <span class:list={["badge", skins[1].status]}>
          {statusLabel(skins[1].status)}
        </span>
      </div>
      <span class="featured-arrow">↗</span>
    </a>
  </section>

  <section class="section events-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">NOVAS HISTÓRIAS NO HORIZONTE</p>
          <h2>
            O reino nunca <em>para.</em>
          </h2>
        </div>
        <a class="text-link" href="/catalogo/eventos/">
          Explorar eventos ↗
        </a>
      </div>
      <div class="event-grid">
        {events.map((item) => (
          <Card item={item} />
        ))}
      </div>
      <p class="muted">
        Eventos em preparação. Datas e recompensas serão anunciadas nas
        respectivas fichas.
      </p>
    </div>
  </section>

  <section class="section wrap knowledge">
    <div>
      <p class="eyebrow">A SABEDORIA TAMBÉM VENCE GUERRAS</p>
      <h2>
        Sua próxima conquista
        <br />
        começa na <em>wiki.</em>
      </h2>
      <p>
        Entenda seu reino, conheça as coleções e prepare seus primeiros passos.
      </p>
      <a class="text-link" href="/wiki/">
        Abrir a central de conhecimento ↗
      </a>
    </div>
    <div class="guide-list">
      {[
        [
          "primeiros-passos",
          "01",
          "Seus primeiros passos",
          "Da escolha do cliente à sua primeira cidade.",
        ],
        [
          "tropas-e-formacoes",
          "02",
          "Conheça seu exército",
          "Famílias, tiers e fichas de unidades.",
        ],
        [
          "aliancas-e-reinos",
          "03",
          "Mais fortes, juntos",
          "Uma introdução a reinos e alianças.",
        ],
      ].map(([slug, n, title, text]) => (
        <a href={`/wiki/${slug}/`}>
          <span>{n}</span>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <img
      src="/media/battle.jpg"
      alt=""
      loading="lazy"
      width="1200"
      height="628"
    />
    <div>
      <p class="eyebrow">ESCREVA O PRÓXIMO CAPÍTULO</p>
      <h2>
        Todo reino precisa
        <br />
        de uma <em>lenda.</em>
      </h2>
      <a class="button" href="/jogar/">
        A sua jornada começa aqui ↗
      </a>
    </div>
  </section>
</Layout>
