---
import Layout from "../../layouts/layout.astro";
import Card from "../../components/card.astro";
import ItemImage from "../../components/item-image.astro";
import { catalog, categories, statusLabel } from "../../lib/catalog.mjs";
import { guides } from "../../data/guides.mjs";
export function getStaticPaths() {
  return [
    ...catalog.map((item) => ({
      params: { slug: item.id },
      props: { item, guide: false },
    })),
    ...guides.map((item) => ({
      params: { slug: item.id },
      props: { item, guide: true },
    })),
  ];
}
const { item, guide } = Astro.props;
const related = guide
  ? []
  : catalog
      .filter((i) => i.category === item.category && i.id !== item.id)
      .slice(0, 4);
---

<Layout title={item.name} description={item.description}>
  <div class="wrap">
    <nav class="breadcrumbs detail-breadcrumbs" aria-label="Caminho">
      <a href="/">Início</a>
      <span>/</span>
      <a href="/wiki/">Wiki</a>
      <span>/</span>
      {!guide && (
        <>
          <a href={`/catalogo/${item.category}/`}>
            {categories[item.category].name}
          </a>
          <span>/</span>
        </>
      )}
      <span>{item.name}</span>
    </nav>
  </div>
  {guide ? (
    <article class="wrap guide-article">
      <header>
        <p class="eyebrow">{item.group}</p>
        <h1>{item.name}</h1>
        <p class="lead">{item.description}</p>
        <img
          class="guide-cover"
          src={item.image}
          alt=""
          width="1200"
          height="628"
        />
      </header>
      <div class="article-layout">
        <aside>
          <p class="eyebrow">NESTE GUIA</p>
          {item.sections.map(([title], i) => (
            <a href={`#parte-${i}`}>{title}</a>
          ))}
          <a href="/wiki/">← Todos os guias</a>
        </aside>
        <div class="article-body">
          {item.sections.map(([title, text], i) => (
            <section id={`parte-${i}`}>
              <h2>{title}</h2>
              <p>{text}</p>
            </section>
          ))}
          <a class="button ghost" href="/catalogo/tropas/">
            Explorar o catálogo ↗
          </a>
        </div>
      </div>
    </article>
  ) : (
    <>
      <article class="wrap item-detail">
        <div class:list={["detail-art", item.category]}>
          <span class:list={["badge", item.status]}>
            {statusLabel(item.status)}
          </span>
          <ItemImage item={item} width="600" height="540" />
        </div>
        <div class="detail-copy">
          <p class="eyebrow">
            {categories[item.category].name} / {item.group}
          </p>
          <h1>{item.name}</h1>
          <p class="lead">{item.description}</p>
          <dl>
            {item.category === "skins" && (
              <div>
                <dt>ID da skin</dt>
                <dd>{item.reference}</dd>
              </div>
            )}
            <div>
              <dt>Status</dt>
              <dd>{statusLabel(item.status)}</dd>
            </div>
            <div>
              <dt>Categoria</dt>
              <dd>{item.group}</dd>
            </div>
            {item.tier && (
              <div>
                <dt>Tier</dt>
                <dd>T{item.tier}</dd>
              </div>
            )}
          </dl>
          <div class="notice">
            <strong>
              {item.status === "available"
                ? "Disponível no projeto"
                : "Uma nova conquista está chegando."}
            </strong>
            <p>
              {item.status === "available"
                ? "Confira no jogo as condições para acessar este conteúdo."
                : "Este conteúdo ainda não está habilitado. Acompanhe esta ficha para saber quando chegar ao jogo."}
            </p>
          </div>
          <p class="muted">{item.note}</p>
          <a class="text-link" href={`/catalogo/${item.category}/`}>
            ← Voltar para {categories[item.category].name.toLowerCase()}
          </a>
        </div>
      </article>
      {related.length > 0 && (
        <section class="section wrap">
          <div class="section-heading">
            <h2>
              Continue <em>explorando.</em>
            </h2>
            <a href={`/catalogo/${item.category}/`} class="text-link">
              Ver coleção completa ↗
            </a>
          </div>
          <div class="card-grid">
            {related.map((item) => (
              <Card item={item} />
            ))}
          </div>
        </section>
      )}
    </>
  )}
</Layout>
