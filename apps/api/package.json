{
  "name": "@opencok/api-service",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --no-env-file src/index.ts",
    "dev": "bun --no-env-file --watch src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun --no-env-file test tests",
    "test:integration": "bun --no-env-file test ../../tests/stack"
  },
  "dependencies": {
    "@opencok/api": "workspace:*",
    "@opencok/env": "workspace:*",
    "@opencok/repositories": "workspace:*",
    "@opencok/storage": "workspace:*"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@opencok/contracts": "workspace:*",
    "@opencok/errors": "workspace:*"
  }
}
