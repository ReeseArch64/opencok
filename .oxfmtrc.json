{
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "**/__snapshots__/**",
    "data/**",
    "docker/**",
    "gameserver",
    "app",
    ".husky/_/**",
    ".github/**",
    "**/*.ts"
  ],
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "quoteProps": "preserve",
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortImports": false,
  "sortPackageJson": false
}
