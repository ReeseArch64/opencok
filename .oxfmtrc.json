{
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "data/**",
    ".husky/_/**",
    "packages/drizzle/migrations/**",
    "**/__snapshots__/**",
    "packages/drizzle/tests/fixtures/**",
    "**/*.{ts,tsx,mts,cts,mtsx,ctsx}"
  ],
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "quoteProps": "preserve",
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortImports": false,
  "sortPackageJson": false
}
