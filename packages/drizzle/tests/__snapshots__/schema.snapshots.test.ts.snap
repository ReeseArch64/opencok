exports[`opencok_global.adcost: schema and CRUD SQL 1`] = `
"schema opencok_global
column ["date","text",true,null,null,null]
column ["googleplay","numeric(12, 2)",false,null,null,null]
column ["facebook","numeric(12, 2)",false,null,null,null]
column ["cn","numeric(12, 2)",false,null,null,null]
column ["kr","numeric(12, 2)",false,null,null,null]
column ["jp","numeric(12, 2)",false,null,null,null]
column ["th","numeric(12, 2)",false,null,null,null]
column ["ru","numeric(12, 2)",false,null,null,null]
column ["tw","numeric(12, 2)",false,null,null,null]
primary ["adcost_PRIMARY",["date"]]
check ["adcost_date_temporal","(\\"date\\" IS NULL OR (CASE WHEN \\"date\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01])$' THEN CASE WHEN left(\\"date\\",4) <> '0000' AND substring(\\"date\\",6,2) <> '00' AND substring(\\"date\\",9,2) <> '00' THEN to_char(to_date(left(\\"date\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"date\\",10) ELSE true END ELSE false END))"]
