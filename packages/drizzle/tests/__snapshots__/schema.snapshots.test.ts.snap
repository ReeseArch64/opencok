exports[`opencok_kingdom.stat_date: schema and CRUD SQL 1`] = `
"schema opencok_kingdom
column ["date","text",true,null,null,null]
column ["dau","integer",true,"0",null,null]
column ["pay","numeric(12, 2)",true,"0.00",null,null]
column ["reg","integer",true,"0",null,null]
primary ["stat_date_PRIMARY",["date"]]
check ["stat_date_date_temporal","(\\"date\\" IS NULL OR (CASE WHEN \\"date\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01])$' THEN CASE WHEN left(\\"date\\",4) <> '0000' AND substring(\\"date\\",6,2) <> '00' AND substring(\\"date\\",9,2) <> '00' THEN to_char(to_date(left(\\"date\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"date\\",10) ELSE true END ELSE false END))"]
insert into "opencok_kingdom"."stat_date" ("date", "dau", "pay", "reg") values ($1, $2, $3, $4)
select "date", "dau", "pay", "reg" from "opencok_kingdom"."stat_date" where "opencok_kingdom"."stat_date"."date" = $1
update "opencok_kingdom"."stat_date" set "date" = $1, "dau" = $2, "pay" = $3, "reg" = $4 where "opencok_kingdom"."stat_date"."date" = $5
delete from "opencok_kingdom"."stat_date" where "opencok_kingdom"."stat_date"."date" = $1"
`;

