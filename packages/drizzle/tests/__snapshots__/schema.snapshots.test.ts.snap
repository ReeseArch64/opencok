exports[`opencok_kingdom.trigger_var: schema and CRUD SQL 1`] = `
"schema opencok_kingdom
column ["type","integer",true,null,null,null]
column ["uid","varchar(50)",true,"''''''",null,null]
column ["key","varchar(200)",true,null,null,null]
column ["value","text",true,null,null,null]
column ["refreshtime","bigint",true,"0",null,null]
column ["createTime","text",true,"to_char(statement_timestamp() AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')",null,null]
column ["lastUpdateTime","text",true,"'0000-00-00 00:00:00'",null,null]
primary ["trigger_var_PRIMARY",["type","uid","key"]]
index ["trigger_var_type_key",false,["\\"type\\"","\\"key\\""]]
index ["trigger_var_uid",false,["\\"uid\\""]]
index ["trigger_var_createTime",false,["\\"createTime\\""]]
index ["trigger_var_lastUpdateTime",false,["\\"lastUpdateTime\\""]]
check ["trigger_var_createTime_temporal","(\\"createTime\\" IS NULL OR (CASE WHEN \\"createTime\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"createTime\\",4) <> '0000' AND substring(\\"createTime\\",6,2) <> '00' AND substring(\\"createTime\\",9,2) <> '00' THEN to_char(to_date(left(\\"createTime\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"createTime\\",10) ELSE true END ELSE false END))"]
check ["trigger_var_lastUpdateTime_temporal","(\\"lastUpdateTime\\" IS NULL OR (CASE WHEN \\"lastUpdateTime\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"lastUpdateTime\\",4) <> '0000' AND substring(\\"lastUpdateTime\\",6,2) <> '00' AND substring(\\"lastUpdateTime\\",9,2) <> '00' THEN to_char(to_date(left(\\"lastUpdateTime\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"lastUpdateTime\\",10) ELSE true END ELSE false END))"]
insert into "opencok_kingdom"."trigger_var" ("type", "uid", "key", "value", "refreshtime", "createTime", "lastUpdateTime") values ($1, $2, $3, $4, $5, $6, $7)
select "type", "uid", "key", "value", "refreshtime", "createTime", "lastUpdateTime" from "opencok_kingdom"."trigger_var" where "opencok_kingdom"."trigger_var"."type" = $1
update "opencok_kingdom"."trigger_var" set "type" = $1, "uid" = $2, "key" = $3, "value" = $4, "refreshtime" = $5, "createTime" = $6, "lastUpdateTime" = $7 where "opencok_kingdom"."trigger_var"."type" = $8
delete from "opencok_kingdom"."trigger_var" where "opencok_kingdom"."trigger_var"."type" = $1"
`;

