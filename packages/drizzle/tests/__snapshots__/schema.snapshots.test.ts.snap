column ["id","integer",true,null,null,null]
column ["hash","varchar(255)",true,null,null,null]
column ["applied_at","text",true,"to_char(statement_timestamp() AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')",null,"to_char(statement_timestamp() AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')"]
column ["apply_script","text",false,null,null,null]
column ["revert_script","text",false,null,null,null]
column ["state","varchar(255)",false,null,null,null]
column ["last_problem","text",false,null,null,null]
primary ["play_evolutions_PRIMARY",["id"]]
check ["play_evolutions_applied_at_temporal","(\\"applied_at\\" IS NULL OR (CASE WHEN \\"applied_at\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"applied_at\\",4) <> '0000' AND substring(\\"applied_at\\",6,2) <> '00' AND substring(\\"applied_at\\",9,2) <> '00' THEN to_char(to_date(left(\\"applied_at\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"applied_at\\",10) ELSE true END ELSE false END))"]
insert into "opencok_kingdom"."play_evolutions" ("id", "hash", "applied_at", "apply_script", "revert_script", "state", "last_problem") values ($1, $2, $3, $4, $5, $6, $7)
select "id", "hash", "applied_at", "apply_script", "revert_script", "state", "last_problem" from "opencok_kingdom"."play_evolutions" where "opencok_kingdom"."play_evolutions"."id" = $1
update "opencok_kingdom"."play_evolutions" set "id" = $1, "hash" = $2, "applied_at" = $3, "apply_script" = $4, "revert_script" = $5, "state" = $6, "last_problem" = $7 where "opencok_kingdom"."play_evolutions"."id" = $8
delete from "opencok_kingdom"."play_evolutions" where "opencok_kingdom"."play_evolutions"."id" = $1"
`;

