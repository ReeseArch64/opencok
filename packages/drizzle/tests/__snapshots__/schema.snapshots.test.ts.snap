exports[`opencok_kingdom.user_gold_wheel_histo: schema and CRUD SQL 1`] = `
"schema opencok_kingdom
column ["uid","varchar(50)",true,null,null,null]
column ["normal_free","integer",true,"0",null,null]
column ["normal_total","integer",true,"0",null,null]
column ["silver_usable","integer",true,"0",null,null]
column ["silver_usable_free","integer",true,"0",null,null]
column ["silver_daily","integer",true,"0",null,null]
column ["silver_total","integer",true,"0",null,null]
