column ["create_time","text",true,null,null,null]
index ["user_gold_wheel_histo_uid",false,["\\"uid\\""]]
check ["user_gold_wheel_histo_create_time_temporal","(\\"create_time\\" IS NULL OR (CASE WHEN \\"create_time\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"create_time\\",4) <> '0000' AND substring(\\"create_time\\",6,2) <> '00' AND substring(\\"create_time\\",9,2) <> '00' THEN to_char(to_date(left(\\"create_time\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"create_time\\",10) ELSE true END ELSE false END))"]
