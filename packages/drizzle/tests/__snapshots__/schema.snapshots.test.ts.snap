index ["chat_message_idx_room_sequence",false,["\\"room_key\\"","\\"sequence_id\\""]]
index ["chat_message_idx_message_expiry",false,["\\"expires_at\\""]]
check ["chat_message_sequence_id_range","\\"sequence_id\\" >= 0 AND \\"sequence_id\\" <= 18446744073709551615"]
check ["chat_message_idempotency_key_length","octet_length(\\"idempotency_key\\") <= 64"]
check ["chat_message_created_at_temporal","(\\"created_at\\" IS NULL OR (CASE WHEN \\"created_at\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}$' THEN CASE WHEN left(\\"created_at\\",4) <> '0000' AND substring(\\"created_at\\",6,2) <> '00' AND substring(\\"created_at\\",9,2) <> '00' THEN to_char(to_date(left(\\"created_at\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"created_at\\",10) ELSE true END ELSE false END))"]
check ["chat_message_expires_at_temporal","(\\"expires_at\\" IS NULL OR (CASE WHEN \\"expires_at\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}$' THEN CASE WHEN left(\\"expires_at\\",4) <> '0000' AND substring(\\"expires_at\\",6,2) <> '00' AND substring(\\"expires_at\\",9,2) <> '00' THEN to_char(to_date(left(\\"expires_at\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"expires_at\\",10) ELSE true END ELSE false END))"]
insert into "opencok_chat"."chat_message" ("sequence_id", "room_key", "sender_uid", "idempotency_key", "body", "created_at", "expires_at") values ($1, $2, $3, $4, $5, $6, $7)
select "sequence_id", "room_key", "sender_uid", "idempotency_key", "body", "created_at", "expires_at" from "opencok_chat"."chat_message" where "opencok_chat"."chat_message"."sequence_id" = $1
update "opencok_chat"."chat_message" set "sequence_id" = $1, "room_key" = $2, "sender_uid" = $3, "idempotency_key" = $4, "body" = $5, "created_at" = $6, "expires_at" = $7 where "opencok_chat"."chat_message"."sequence_id" = $8
delete from "opencok_chat"."chat_message" where "opencok_chat"."chat_message"."sequence_id" = $1"
`;

