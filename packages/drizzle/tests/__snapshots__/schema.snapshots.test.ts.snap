exports[`opencok_kingdom.cok_monitor_log: schema and CRUD SQL 1`] = `
"schema opencok_kingdom
column ["id","integer",true,null,{"type":"byDefault","sequenceName":"cok_monitor_log_id_seq","sequenceOptions":{"startWith":1}},null]
column ["url","varchar(500)",false,null,null,null]
column ["action","varchar(50)",false,null,null,null]
column ["parameter","text",false,null,null,null]
column ["user_name","varchar(50)",false,null,null,null]
column ["access_time","text",false,null,null,null]
column ["module_id","integer",false,null,null,null]
primary ["cok_monitor_log_PRIMARY",["id"]]
check ["cok_monitor_log_access_time_temporal","(\\"access_time\\" IS NULL OR (CASE WHEN \\"access_time\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"access_time\\",4) <> '0000' AND substring(\\"access_time\\",6,2) <> '00' AND substring(\\"access_time\\",9,2) <> '00' THEN to_char(to_date(left(\\"access_time\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"access_time\\",10) ELSE true END ELSE false END))"]
insert into "opencok_kingdom"."cok_monitor_log" ("id", "url", "action", "parameter", "user_name", "access_time", "module_id") values ($1, $2, $3, $4, $5, $6, $7)
select "id", "url", "action", "parameter", "user_name", "access_time", "module_id" from "opencok_kingdom"."cok_monitor_log" where "opencok_kingdom"."cok_monitor_log"."id" = $1
update "opencok_kingdom"."cok_monitor_log" set "id" = $1, "url" = $2, "action" = $3, "parameter" = $4, "user_name" = $5, "access_time" = $6, "module_id" = $7 where "opencok_kingdom"."cok_monitor_log"."id" = $8
delete from "opencok_kingdom"."cok_monitor_log" where "opencok_kingdom"."cok_monitor_log"."id" = $1"
