exports[`opencok_kingdom.dragon_playoff_properties: schema and CRUD SQL 1`] = `
"schema opencok_kingdom
column ["key","varchar(100)",true,null,null,null]
column ["value","varchar(1000)",false,null,null,null]
column ["updateTime","text",true,"to_char(statement_timestamp() AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')",null,"to_char(statement_timestamp() AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS')"]
primary ["dragon_playoff_properties_PRIMARY",["key"]]
check ["dragon_playoff_properties_updateTime_temporal","(\\"updateTime\\" IS NULL OR (CASE WHEN \\"updateTime\\" ~ '^[0-9]{4}-(0[0-9]|1[0-2])-(0[0-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$' THEN CASE WHEN left(\\"updateTime\\",4) <> '0000' AND substring(\\"updateTime\\",6,2) <> '00' AND substring(\\"updateTime\\",9,2) <> '00' THEN to_char(to_date(left(\\"updateTime\\",10),'YYYY-MM-DD'),'YYYY-MM-DD') = left(\\"updateTime\\",10) ELSE true END ELSE false END))"]
insert into "opencok_kingdom"."dragon_playoff_properties" ("key", "value", "updateTime") values ($1, $2, $3)
select "key", "value", "updateTime" from "opencok_kingdom"."dragon_playoff_properties" where "opencok_kingdom"."dragon_playoff_properties"."key" = $1
update "opencok_kingdom"."dragon_playoff_properties" set "key" = $1, "value" = $2, "updateTime" = $3 where "opencok_kingdom"."dragon_playoff_properties"."key" = $4
delete from "opencok_kingdom"."dragon_playoff_properties" where "opencok_kingdom"."dragon_playoff_properties"."key" = $1"
`;

