exports[`Drizzle schema translation snapshots the synthetic schema contract 1`] = `
"// Generated by scripts/generate.ts from authorized local DDL; no rows or stored programs.

// MariaDB-only attributes are preserved in migrations/<database>/0000_legacy.sql.

import { sql } from "drizzle-orm";

import { bigint, datetime, decimal, mysqlTable, primaryKey, uniqueIndex } from "drizzle-orm/mysql-core";

import { binaryData } from "../binary";

export const synthetic = mysqlTable("synthetic", {
  "id": bigint("id", {"mode":"bigint","unsigned":true}).notNull(),
  "key": binaryData("key", {"type":"varbinary(64)"}).notNull(),
  "price": decimal("price", {"precision":10,"scale":2}).default(sql.raw("0.00")),
  "created": datetime("created", {"mode":"string","fsp":3}).notNull(),
}, (table) => [
  primaryKey({ columns: [table["id"]] }),
  uniqueIndex("key_idx").on(table["key"]),
]);
"
`;
