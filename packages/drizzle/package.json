{
  "name": "@opencok/drizzle",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/opencok_chat/chat_social": "./src/schema/chat-social.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:generate": "bun --no-env-file scripts/kit.ts generate",
    "db:migrate": "bun --no-env-file scripts/migrate.ts",
    "db:check": "bun --no-env-file scripts/kit.ts check",
    "db:studio": "bun --no-env-file scripts/kit.ts studio",
    "test": "bun run test:unit && bun run test:snapshots",
    "test:unit": "bun --no-env-file test tests/schema.unit.test.ts tests/topology.unit.test.ts tests/environment.unit.test.ts tests/utf8-bytea.unit.test.ts",
    "test:snapshots": "bun --no-env-file test tests/schema.snapshots.test.ts",
    "test:e2e": "bun --no-env-file test tests/database.e2e.test.ts tests/namespaces.e2e.test.ts tests/mail-reward.e2e.test.ts",
    "db:setup": "bun --no-env-file scripts/setup.ts"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "@opencok/env": "workspace:*",
    "@opencok/core": "workspace:*"
  }
}
