{
  "name": "@opencok/drizzle",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/global": "./src/schema/global.ts",
    "./schema/kingdom": "./src/schema/kingdom.ts",
    "./schema/opencok_kingdom": "./src/schema/opencok_kingdom.ts",
    "./schema/opencok_kingdom/*": "./src/schema/opencok_kingdom/*.ts",
    "./schema/opencok_global": "./src/schema/opencok_global.ts",
    "./schema/opencok_global/*": "./src/schema/opencok_global/*.ts",
    "./schema/opencok_pay": "./src/schema/opencok_pay.ts",
    "./schema/opencok_pay/*": "./src/schema/opencok_pay/*.ts",
    "./schema/opencok_chat": "./src/schema/opencok_chat.ts",
    "./schema/opencok_chat/*": "./src/schema/opencok_chat/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "test": "bun run test:unit && bun run test:snapshots",
    "test:unit": "bun test tests/schema.unit.test.ts tests/topology.unit.test.ts",
    "test:snapshots": "bun test tests/schema.snapshots.test.ts",
    "test:e2e": "bun test tests/database.e2e.test.ts tests/namespaces.e2e.test.ts",
    "db:setup": "bun scripts/setup.ts"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
