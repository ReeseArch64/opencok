{
  "name": "@opencok/drizzle",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/cokdb1": "./src/schema/cokdb1.ts",
    "./schema/cokdb_global": "./src/schema/cokdb_global.ts",
    "./schema/cokdb_pay": "./src/schema/cokdb_pay.ts",
    "./schema/opencok_chat": "./src/schema/opencok_chat.ts",
    "./schema/cokdb1/*": "./src/schema/cokdb1/*.ts",
    "./schema/cokdb_global/*": "./src/schema/cokdb_global/*.ts",
    "./schema/cokdb_pay/*": "./src/schema/cokdb_pay/*.ts",
    "./schema/opencok_chat/*": "./src/schema/opencok_chat/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "bun scripts/generate.ts",
    "db:check": "bun scripts/generate.ts --check",
    "db:bootstrap": "bun scripts/bootstrap.ts",
    "db:preview": "drizzle-kit export --config drizzle.config.ts",
    "test": "bun run test:unit && bun run test:snapshots",
    "test:unit": "bun test tests/legacy-sql.test.ts tests/tables.unit.test.ts",
    "test:snapshots": "bun test tests/tables.snapshots.test.ts",
    "test:e2e": "bun test tests/tables.e2e.test.ts",
    "test:integration": "bun tests/mariadb.integration.ts"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6"
  }
}
