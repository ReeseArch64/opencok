{
  "name": "@opencok/resources",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun --no-env-file test tests",
    "import:catalogs": "bun --no-env-file scripts/import-gameplay-catalogs.ts",
    "import:buildings": "bun --no-env-file scripts/import-building-definitions.ts"
  },
  "devDependencies": {
    "@opencok/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "fast-xml-parser": "^5.0.0"
  },
  "type": "module",
  "exports": {
    "./buildings": "./src/buildings/index.ts",
    "./definitions": "./src/catalog-definitions.ts",
    "./fixtures": "./src/xml-fixtures.ts",
    "./catalogs/*": "./src/catalogs/types/*.ts",
    "./*": "./src/*.ts",
    "./*.json": "./src/*.json",
    "./catalogs/types/*": "./src/catalogs/types/*.ts",
    "./catalogs/data/*": "./src/catalogs/data/*.ts",
    "./catalogs/*.json": "./src/catalogs/*.json"
  },
  "dependencies": {
    "@opencok/rules": "workspace:*",
    "@opencok/enums": "workspace:*",
    "@opencok/contracts": "workspace:*",
    "@opencok/hero": "workspace:*",
    "@opencok/constants": "workspace:*",
    "@opencok/dragon": "workspace:*",
    "@opencok/policy": "workspace:*"
  }
}
