{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "mutate": ["src/binary.ts", "src/world.ts"],
  "testRunner": "vitest",
  "tsconfigFile": "",
  "vitest": {
    "configFile": "vitest.config.mjs"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 1,
  "incremental": true,
  "incrementalFile": "coverage/mutation/stryker-incremental.json",
  "timeoutMS": 10000,
  "reporters": ["progress", "clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "tempDirName": "coverage/.stryker-tmp",
  "ignorePatterns": ["coverage"]
}
