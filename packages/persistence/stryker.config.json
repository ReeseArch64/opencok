{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "tsconfigFile": "",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.mjs"
  },
  "mutate": ["src/factories/kingdom-database.ts", "src/validators/world-cell.ts"],
  "tempDirName": "coverage/.stryker-tmp",
  "ignorePatterns": ["coverage"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 1,
  "incremental": true,
  "incrementalFile": "coverage/mutation/stryker-incremental.json",
  "timeoutMS": 10000
}
