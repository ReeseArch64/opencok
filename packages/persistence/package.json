{
  "name": "@opencok/persistence",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/models/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "format": "dprint fmt --config ../../dprint.json --allow-no-files .",
    "migration:run": "bun --no-env-file --tsconfig-override tsconfig.json ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "bun --no-env-file --tsconfig-override tsconfig.json ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:show": "bun --no-env-file --tsconfig-override tsconfig.json ./node_modules/typeorm/cli.js migration:show -d src/data-source.ts",
    "check-types": "tsc --noEmit",
    "test": "bun run test:unit && vitest run && vitest run --config vitest.database.config.mjs",
    "test:unit": "bun test --no-env-file --tsconfig-override tsconfig.json ./src ./tests/*.test.ts",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration && vitest run --config vitest.database.config.mjs tests/integration",
    "test:snapshot": "vitest run tests/snapshot",
    "test:property": "vitest run tests/property",
    "test:e2e": "vitest run --config vitest.database.config.mjs tests/e2e",
    "test:coverage": "bun test --no-env-file --tsconfig-override tsconfig.json ./src ./tests/*.test.ts --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage/bun && vitest run --coverage",
    "test:mutation": "timeout --signal=INT --kill-after=5s 90s stryker run",
    "migrate": "bun --no-env-file --tsconfig-override tsconfig.json scripts/migrate.ts",
    "seed": "bun --no-env-file --tsconfig-override tsconfig.json scripts/seed.ts"
  },
  "devDependencies": {
    "@opencok/config": "workspace:",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bun": "catalog:",
    "@types/mongodb": "^4.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/pg": "^8.23.1",
    "@types/reflect-metadata": "^0.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/snapshot": "5.1.0",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1",
    "typescript": "catalog:",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "mongoose": "^9.12.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "catalog:"
  }
}
